# Configuration file for TrialGuard AI

# Database
DATABASE_URL=sqlite:///./trialguard.db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ML Models
CONTAMINATION=0.1
N_NEIGHBORS=20
RANDOM_STATE=42

# Data Paths
DATA_DIR=./data
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
FEATURES_DIR=./data/features
RESULTS_DIR=./data/results
MODELS_DIR=./data/models

# Logging
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
